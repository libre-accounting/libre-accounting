{
    "name": "libre-accounting/libre-accounting",
    "description": "Open Source Accounting Software built with Laravel",
    "homepage": "https://libreaccounting.org",
    "keywords": [
        "laravel",
        "accounting",
        "invoice",
        "expenses",
        "software",
        "online"
    ],
    "license": "GPL-3.0+",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "akaunting/laravel-apexcharts": "^3.0",
        "akaunting/laravel-debugbar-collector": "^2.0",
        "akaunting/laravel-firewall": "^2.0",
        "akaunting/laravel-language": "^1.0",
        "akaunting/laravel-module": "^3.0",
        "akaunting/laravel-money": "^6.0",
        "akaunting/laravel-mutable-observer": "^3.0",
        "akaunting/laravel-setting": "^1.2",
        "akaunting/laravel-sortable": "^3.0",
        "akaunting/laravel-version": "^1.0",
        "akaunting/module-offline-payments": "^3.0",
        "akaunting/module-paypal-standard": "^3.0",
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-ide-helper": "^3.0",
        "bkwld/cloner": "^3.10",
        "bugsnag/bugsnag-laravel": "^2.24",
        "graham-campbell/markdown": "^16.0",
        "guzzlehttp/guzzle": "^7.4",
        "intervention/image": "^3.9",
        "laracasts/flash": "3.2.*",
        "laravel/framework": "^12.69",
        "laravel/sanctum": "^4.0",
        "laravel/slack-notification-channel": "^3.2",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^4.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/oauth2-client": "^2.6",
        "league/omnipay": "^3.2",
        "libre-accounting/laravel-menu": "^3.2",
        "libre-accounting/laravel-search-string": "^1.4",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "3.1.*",
        "mike-bronner/laravel-model-caching": "^13.0",
        "mnsami/composer-custom-directory-installer": "2.0.*",
        "nesbot/carbon": "^3.8",
        "plank/laravel-mediable": "^7.0",
        "riverskies/laravel-mobile-detect": "^1.3",
        "santigarcor/laratrust": "^8.4",
        "sentry/sentry-laravel": "^4.13",
        "simple-icons/simple-icons": "^6.0",
        "simshaun/recurr": "^5.0",
        "staudenmeir/belongs-to-through": "^2.17",
        "staudenmeir/eloquent-has-many-deep": "^1.21",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "symfony/postmark-mailer": "^7.0",
        "symfony/sendgrid-mailer": "^7.0"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^2.0",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.0",
        "wnx/laravel-stats": "^2.15"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/libre-accounting/laravel-menu"
        },
        {
            "type": "vcs",
            "url": "https://github.com/libre-accounting/laravel-search-string"
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "installer-paths": {
            "modules/OfflinePayments": ["akaunting/module-offline-payments"],
            "modules/PaypalStandard": ["akaunting/module-paypal-standard"]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": ["app/"],
            "Akaunting\\Module\\Commands\\": "overrides/akaunting/laravel-module/Commands/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeds\\": "database/seeds/",
            "Illuminate\\Translation\\": "overrides/Illuminate/Translation/",
            "Illuminate\\View\\Concerns\\": "overrides/Illuminate/View/Concerns/",
            "Maatwebsite\\Excel\\": "overrides/maatwebsite/excel/",
            "Modules\\": "modules/",
            "Symfony\\Component\\Process\\": "overrides/symfony/process/"
        },
        "exclude-from-classmap": [
            "vendor/akaunting/laravel-module/src/Commands/DeleteCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/DisableCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/EnableCommand.php",
            "vendor/akaunting/laravel-module/src/Commands/InstallCommand.php",
            "vendor/laravel/framework/src/Illuminate/Translation/MessageSelector.php",
            "vendor/laravel/framework/src/Illuminate/View/Concerns/ManagesStacks.php",
            "vendor/maatwebsite/excel/src/Fakes/ExcelFake.php",
            "vendor/maatwebsite/excel/src/QueuedWriter.php",
            "vendor/symfony/process/PhpExecutableFinder.php"
        ],
        "files": [
            "app/Utilities/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan ide-helper:models --nowrite"
        ],
        "post-update-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan ide-helper:models --nowrite"
        ],
        "post-create-project-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "prod": [
            "composer install --prefer-dist --no-interaction --no-scripts --no-progress --no-ansi --no-dev",
            "composer dump-autoload"
        ],
        "test": [
            "composer install --prefer-dist --no-interaction --no-scripts --no-progress --no-ansi",
            "composer dump-autoload"
        ],
        "test:sqlite": [
            "@putenv DB_CONNECTION=sqlite",
            "@putenv DB_DATABASE=:memory:",
            "@php artisan test --parallel"
        ],
        "test:mysql": [
            "@putenv DB_CONNECTION=mysql",
            "@putenv DB_HOST=mysql-test",
            "@putenv DB_PORT=3306",
            "@putenv DB_DATABASE=libre_test",
            "@putenv DB_USERNAME=root",
            "@putenv DB_PASSWORD=root",
            "@php artisan test --parallel --recreate-databases"
        ],
        "test:pgsql": [
            "@putenv DB_CONNECTION=pgsql",
            "@putenv DB_HOST=pgsql-test",
            "@putenv DB_PORT=5432",
            "@putenv DB_DATABASE=libre_test",
            "@putenv DB_USERNAME=libre",
            "@putenv DB_PASSWORD=secret",
            "@php artisan test --parallel --recreate-databases"
        ],
        "test:all": [
            "@test:sqlite",
            "@test:mysql",
            "@test:pgsql"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "mnsami/composer-custom-directory-installer": true,
            "php-http/discovery": true
        }
    }
}
